#!/usr/bin/env bash
# PATH shim — resolves the repo venv so `vm` works from any directory with no cd.
set -euo pipefail
VM_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -x "$VM_ROOT/venv/Scripts/python.exe" ]; then
  VM_PY="$VM_ROOT/venv/Scripts/python.exe"
elif [ -x "$VM_ROOT/venv/bin/python" ]; then
  VM_PY="$VM_ROOT/venv/bin/python"
else
  VM_PY="python"
fi

# Under Git Bash / MSYS on Windows, $VM_ROOT is a POSIX path (/d/user/...) that a Windows
# Python cannot import from. Hand the interpreter a native path instead.
if command -v cygpath >/dev/null 2>&1; then
  VM_ROOT="$(cygpath -w "$VM_ROOT")"
fi

exec "$VM_PY" -c "import sys; sys.path.insert(0, r'$VM_ROOT'); from vm.cli import main; raise SystemExit(main())" "$@"

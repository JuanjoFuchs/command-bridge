# Copy to .env (gitignored) and fill in. Nothing here is required for localhost dev.

# Shared secret required on the WebSocket handshake. If unset, the server
# generates one at startup and prints it — but set it explicitly for a phone
# session so the URL stays stable across restarts.
VM_TOKEN=

# Extra CIDRs allowed to reach the server, comma-separated.
# Loopback is always allowed. Add the Tailscale CGNAT range for phone access:
#   VM_ALLOW_CIDRS=100.64.0.0/10
VM_ALLOW_CIDRS=

# CIDRs whose members are trusted to set X-Forwarded-For. Leave EMPTY unless a
# reverse proxy actually fronts this server — an empty value means the header is
# ignored entirely and the direct TCP peer decides. See ai-docs/reference/security.md.
VM_TRUSTED_PROXIES=

# Where session turn logs live. Default: ./sessions
VM_DIR=

# TTS backend: sapi (Windows, zero-install, default) | piper | none
VM_TTS=sapi

# Piper only — path to the binary and the .onnx voice model.
VM_PIPER_BIN=
VM_PIPER_VOICE=

# Whisper model for ASR. small.en is the validated default (RTF ~0.10 on CPU).
VM_WHISPER_MODEL=small.en

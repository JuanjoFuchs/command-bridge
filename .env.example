# voice-tunnel settings — copy to `.env` (gitignored) or write it with `voice-tunnel config set`.
#
# Every `voice-tunnel` command loads this file automatically, so nothing here has to be
# re-exported on each call. Precedence is:
#
#     process environment  >  this file  >  built-in default
#
# so a one-off override is still just a prefix: `VOICE_TUNNEL_TTS=none voice-tunnel say --session dev "hi"`.
#
# Nothing here is required for localhost dev — every value below has a working default.
# `voice-tunnel config show` prints the live value of each setting and where it came from.
# `voice-tunnel doctor` says what is missing and the exact command that fixes it.
#
# VOICE_TUNNEL_ENV_FILE points at this file. It can only be set as a real environment variable (a path to
# the settings file, written inside the settings file, would be read too late to matter) and
# exists so tests and alternate profiles can point somewhere else.

# --- security ---------------------------------------------------------------

# Shared secret required on the WebSocket handshake. If unset, the server generates one at
# startup and prints it — but set it explicitly for a phone session so the URL stays stable
# across restarts.
VOICE_TUNNEL_TOKEN=

# Extra CIDRs allowed to reach the server, comma-separated. Loopback is always allowed.
# Add the Tailscale CGNAT range for phone access:  VOICE_TUNNEL_ALLOW_CIDRS=100.64.0.0/10
VOICE_TUNNEL_ALLOW_CIDRS=

# CIDRs whose members are trusted to set X-Forwarded-For. Leave EMPTY unless a reverse proxy
# actually fronts this server — empty means the header is ignored entirely and the direct TCP
# peer decides. See ai-docs/reference/security.md.
VOICE_TUNNEL_TRUSTED_PROXIES=

# The https URL a phone actually opens, when something you started is forwarding to this port.
# Every working phone path (ngrok, `tailscale serve`, cloudflared, any reverse proxy) forwards
# from LOOPBACK, so `status.phone.ready` — derived from the bind host — is false even while the
# tunnel is working, and its remedy repeats advice you already followed. ngrok is detected from
# its own local agent API and needs nothing here; anything else is invisible from inside this
# tool, so assert it:  VOICE_TUNNEL_PUBLIC_URL=https://your-host.example.com
#
# READ THIS BEFORE YOU FRONT THE PORT. A forwarder connects from 127.0.0.1, so every request it
# relays arrives as a loopback peer and passes VOICE_TUNNEL_ALLOW_CIDRS unconditionally — the
# allowlist above stops protecting you the moment a tunnel is up, and the token in the URL is the
# only gate left. Set VOICE_TUNNEL_TOKEN yourself, and prefer a forwarder that adds its own auth.
VOICE_TUNNEL_PUBLIC_URL=

# --- paths ------------------------------------------------------------------

# Where session turn logs and voiceprints live.
# Default: <repo>/sessions in a checkout, <user data dir>/voice-tunnel/sessions once installed.
VOICE_TUNNEL_DIR=

# Where downloaded models live (piper voices, parakeet). Point this at a big disk if you like —
# a Parakeet checkpoint is ~600 MB. Default: <repo>/models, or <user data dir>/voice-tunnel/models.
VOICE_TUNNEL_MODELS_DIR=

# --- speech out -------------------------------------------------------------

# TTS backend: sapi (Windows, zero-install, default) | piper | kokoro | none
VOICE_TUNNEL_TTS=

# Piper only. Both are auto-discovered — the binary from <repo>/venv/Scripts/piper.exe then
# PATH, the voice from <repo>/models (en_GB-alan-medium, else the sole installed voice) — so
# `VOICE_TUNNEL_TTS=piper` on its own is usually enough. Set these to override the discovery.
VOICE_TUNNEL_PIPER_BIN=
VOICE_TUNNEL_PIPER_VOICE=

# 1 (default) | 0 — hold the voice model in the server process instead of spawning piper.exe
# per reply. Measured on this machine: 3.6-4.3 s per call spawning (nearly all of it startup)
# versus 0.17-0.58 s resident, i.e. 7-26x. Set 0 only if VOICE_TUNNEL_PIPER_BIN points at a non-Python
# piper build, or to A/B a suspected regression in the resident path.
VOICE_TUNNEL_PIPER_INPROCESS=

# Kokoro only, and all three are auto-discovered — the model and the voice pack from <repo>/models
# (`voice-tunnel download kokoro` puts them there), the voice from the pack — so
# `VOICE_TUNNEL_TTS=kokoro` on its own is usually enough. Set these to override the discovery.
#
# Kokoro is ONE model plus ONE pack holding all 54 voices, which is why VOICE_TUNNEL_KOKORO_VOICE
# takes a NAME (bm_daniel, bm_lewis, af_heart, ...) while VOICE_TUNNEL_PIPER_VOICE takes a path:
# under piper a voice IS a file, under kokoro it is a style vector inside one. Switching voices
# therefore costs a dictionary lookup and no download. Default bm_daniel.
VOICE_TUNNEL_KOKORO_VOICE=
VOICE_TUNNEL_KOKORO_MODEL=
VOICE_TUNNEL_KOKORO_VOICES=

# How fast the agent talks, as a MULTIPLE of the voice's native pace — higher is faster,
# range 0.5-2.5. Default 1.18, because en_GB-alan-medium reads slowly at native pace; above
# ~1.33 it starts clipping consonants. Piper's own length_scale is inverted and is deliberately
# NOT exposed. Change it live (and write it here) with `voice-tunnel rate --speed 1.3`.
#
# KOKORO CAPS THIS AT 2.0, not 2.5 — `kokoro_onnx` asserts it. A higher value here is accepted
# and persisted (piper uses it fine) and then clamped at the kokoro boundary rather than raising;
# `voice-tunnel status` and `doctor` say so when it happens.
VOICE_TUNNEL_SPEECH_SPEED=

# Seconds of silence between sentences, 0-1.5. Default 0.5. Speech has no scrollback, so this
# pause IS the punctuation — a spoken list without it runs together. `voice-tunnel rate --pause 0.6`.
VOICE_TUNNEL_SENTENCE_PAUSE=

# De-esser strength, 0-1. Default 0.6, ON. Tames the piercing 's' that gets worse at high speed
# and through a phone speaker. It is dynamic, not a treble cut: gain is exactly 1.0 on every
# frame where the high band is not dominant, so vowels and consonant attacks are untouched.
# Set 0 to disable, or lower it if the voice starts to lisp.
VOICE_TUNNEL_DEESS=

# --- speech in --------------------------------------------------------------

# ASR engine: parakeet | whisper. Auto-selects parakeet when its model directory is present
# (8x faster than whisper small.en on this machine, from a more accurate model).
VOICE_TUNNEL_ASR=

# Path to a sherpa-onnx Parakeet TDT model directory. Default: inside the models dir above.
VOICE_TUNNEL_PARAKEET_DIR=

# Whisper fallback model. Default base.en — small.en was benchmarked as 3x slower for
# identical output on the test utterance.
VOICE_TUNNEL_WHISPER_MODEL=

# ASR worker threads (default 4) and whisper beam width (default 1 — model size dominates
# speed by ~3x, so widening the beam buys almost nothing).
VOICE_TUNNEL_ASR_THREADS=
VOICE_TUNNEL_ASR_BEAM=

# Silence in milliseconds that ends a turn. Default 1500. Raise it if you get cut off while
# thinking mid-sentence; lower it if replies feel sluggish. Costs latency on every reply.
#
# NOTE, measured 2026-08-17: with the turn model installed this number now decides almost nothing.
# Over 139 live turns the plain timer fired ZERO times — the model closed every one of them. The
# four settings below are the ones that matter.
VOICE_TUNNEL_END_OF_UTTERANCE_MS=

# --- learned turn detection (smart-turn v3.2) -------------------------------

# 1 | 0 — let the model decide when a turn has ended. Default 1 when the model is installed.
# Setting 0 returns to the fixed timer above, which was RAISED from 1000 because it kept cutting
# him off — so this is an A/B switch, not a fix.
VOICE_TUNNEL_TURN_DETECT=

# 0-1 — probability at or above which an utterance counts as finished. Default 0.5.
#
# RAISING THIS DOES NOT STOP TRUNCATION, measured on the 2026-08-17 session: the five utterances
# cut mid-sentence scored a median 0.965, ABOVE the 0.931 median of the early exits that were
# correct. The model is confidently wrong, not hesitant, so no threshold separates the two. Use
# VOICE_TUNNEL_TURN_MIN_SILENCE_MS instead. Kept settable so the finding can be re-tested.
VOICE_TUNNEL_TURN_THRESHOLD=

# Milliseconds of trailing silence below which NO amount of model confidence may close a turn
# early. Default 800, raised from 400 after all five live truncations were measured closing at
# 0.44-0.48 s. 600-900 behave identically, so 800 is the middle of the plateau rather than its
# edge. THIS is the knob to raise if you are still being cut off.
VOICE_TUNNEL_TURN_MIN_SILENCE_MS=

# ONNX intra-op threads for the turn model. Default 4, measured on a 4 s utterance: 1 -> 212 ms,
# 2 -> 196, 4 -> 133, 8 -> 156. Being "polite" with one thread cost 79 ms on every turn.
VOICE_TUNNEL_TURN_THREADS=

# --- behaviour --------------------------------------------------------------

# 1 | 0 — short non-speech cues so a pause is legible without looking at the page.
VOICE_TUNNEL_CUES=

# 1 | 0 — narrate every action BEFORE doing it. Default 0. Written by `voice-tunnel verbose on`, and
# GLOBAL rather than per-device on purpose: this is a preference about the agent, held once, so
# flipping it on a laptop must follow him to the phone. Mute is the opposite — it is a fact about
# one device's microphone and deliberately stays local.
VOICE_TUNNEL_VERBOSE=

# Name the voiceprint gallery learns under. Default: me
VOICE_TUNNEL_OWNER=

# What you call the agent. "hey <name>" is the summons; a greeting is ALWAYS required and is not
# configurable. Default: assistant.
#
# Set this to the name of whatever agent is driving the tunnel — claude, codex, grok. The usual
# way is `voice-tunnel serve --wake codex`, which writes it here for you; `voice-tunnel wake
# --name codex` changes it on a running server without a restart.
#
# The mandatory greeting is what makes ANY name safe. "grok" is an English verb and "cursor" is a
# word you say constantly while coding, but nobody says "hey grok" by accident. There used to be
# a VOICE_TUNNEL_WAKE_BARE switch to allow the bare name for supposedly uncommon names; it was
# removed because it asked you to predict a collision you can only get wrong, and the cost of
# being wrong is an agent that talks over conversations it was never part of.
#
# The phrase is the FALLBACK, not the gate — once the voiceprint knows you, you are addressed
# without saying anything. See `voice-tunnel voiceprint`.
VOICE_TUNNEL_WAKE_NAME=
